<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="28dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HamHaeVoca"
        style="@style/TitleText" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="오늘도 가볍게 단어를 익혀보세요"
        style="@style/BodyText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bookSectionTitle"
            style="@style/SectionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="내 단어장" />

        <ImageButton
            android:id="@+id/importButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="새 단어장 불러오기"
            android:padding="12dp"
            android:src="@drawable/ic_add_book"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/folderButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="폴더 선택 및 관리"
            android:padding="12dp"
            android:src="@drawable/ic_folder_outline"
            android:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/bookSearchButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_icon_button"
            android:contentDescription="단어장 검색 열기 또는 닫기"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_search"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bookSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="vertical">
        <EditText
            android:id="@+id/bookSearchInput"
            style="@style/InputField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="단어장 검색"
            android:inputType="text"
            android:singleLine="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:padding="28dp"
        android:text="아직 저장된 단어장이 없어요.\nTXT, CSV, TSV 또는 XLSX 파일을 불러와 보세요."
        style="@style/BodyText" />

    <ListView
        android:id="@+id/bookList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp"
        android:paddingBottom="12dp" />
</LinearLayout>
